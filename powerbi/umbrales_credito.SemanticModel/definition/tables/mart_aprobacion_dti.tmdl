	partition mart_aprobacion_dti = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\marts\mart_aprobacion_dti.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado0 = Table.TransformColumnTypes(Encabezados, {{"producto", type text}, {"dti", type text}, {"dti_orden", type number}, {"decisiones", Int64.Type}, {"aprobadas", Int64.Type}, {"aprobacion_pct", type number}, {"spread_mediano", type number}, {"tasa_mediana", type number}}, "en-US"),
