				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado0 = Table.TransformColumnTypes(Encabezados, {{"situacion", Int64.Type}, {"nombre", type text}, {"dias_desde", Int64.Type}, {"dias_hasta", Int64.Type}, {"prevision_sin_garantia_pct", Int64.Type}}, "en-US")
