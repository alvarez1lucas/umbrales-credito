		annotation SummarizationSetBy = Automatic

	column orden
		dataType: int64
		lineageTag: 6d1021df-2177-5e59-9dc5-269673f2ffe4
		summarizeBy: none
		sourceColumn: orden

		annotation SummarizationSetBy = Automatic

	column nombre
		dataType: string
