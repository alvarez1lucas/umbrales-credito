	partition regla_canal = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\cobranzas\regla_canal.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
