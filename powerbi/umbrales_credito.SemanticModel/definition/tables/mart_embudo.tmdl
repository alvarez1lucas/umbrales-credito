	partition mart_embudo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\marts\mart_embudo.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado0 = Table.TransformColumnTypes(Encabezados, {{"anio", Int64.Type}, {"producto", type text}, {"resultado", type text}, {"solicitudes", Int64.Type}, {"monto", type number}}, "en-US"),
				    Resultado1 = Table.TransformColumns(Resultado0, {{"resultado", (v) => List.First(List.Select({[a = "otorgado", b = "Otorgado"], [a = "desistido", b = "Desistido"], [a = "rechazado", b = "Rechazado"], [a = "incompleto", b = "Incompleto"], [a = "aprobado_no_aceptado", b = "Aprobado, no aceptado"]}, (r) => r[a] = v))[b], type text}})
				in
				    Resultado1

