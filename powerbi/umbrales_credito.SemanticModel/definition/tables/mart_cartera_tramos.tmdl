	partition mart_cartera_tramos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\marts\mart_cartera_tramos.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado0 = Table.TransformColumnTypes(Encabezados, {{"fecha_foto", type date}, {"pais", type text}, {"rating", type text}, {"tramo", type text}, {"creditos", Int64.Type}, {"saldo_capital", type number}}, "en-US")
				in
				    Resultado0

