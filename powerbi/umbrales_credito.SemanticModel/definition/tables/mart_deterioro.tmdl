	partition mart_deterioro = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\marts\mart_deterioro.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado0 = Table.TransformColumnTypes(Encabezados, {{"cosecha_anio", Int64.Type}, {"pais", type text}, {"rating", type text}, {"creditos", Int64.Type}, {"eventos_12m", Int64.Type}, {"monto", type number}}, "en-US"),
				    Resultado1 = Table.SelectRows(Resultado0, each [pais] <> "Slovakia")
				in
				    Resultado1

