	partition escenario_canales = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\cobranzas\escenario_canales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado0 = Table.TransformColumnTypes(Encabezados, {{"tramo", type text}, {"canal", type text}, {"evitado_por_cuenta", type number}, {"costo_por_cuenta", type number}, {"neto_por_cuenta", type number}, {"evitado_por_euro", type number}}, "en-US"),
				    Resultado1 = Table.TransformColumns(Resultado0, {{"canal", (v) => List.First(List.Select({[a = "llamada", b = "Call"], [a = "whatsapp", b = "WhatsApp"], [a = "sms", b = "SMS"], [a = "mail", b = "Email"]}, (r) => r[a] = v))[b], type text}})
				in
				    Resultado1

