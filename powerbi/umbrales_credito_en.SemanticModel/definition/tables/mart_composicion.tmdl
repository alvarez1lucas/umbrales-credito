	partition mart_composicion = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\marts\mart_composicion.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado0 = Table.TransformColumnTypes(Encabezados, {{"fecha_foto", type date}, {"pais", type text}, {"rating", type text}, {"plazo", type text}, {"plazo_orden", Int64.Type}, {"creditos", Int64.Type}, {"saldo_capital", type number}, {"saldo_par30", type number}, {"saldo_par90", type number}}, "en-US"),
				    Resultado1 = Table.TransformColumns(Resultado0, {{"plazo", (v) => List.First(List.Select({[a = "Hasta 24", b = "Up to 24"], [a = "25-36", b = "25-36"], [a = "37-48", b = "37-48"], [a = "49-60", b = "49-60"], [a = "Más de 60", b = "Over 60"]}, (r) => r[a] = v))[b], type text}})
				in
				    Resultado1

