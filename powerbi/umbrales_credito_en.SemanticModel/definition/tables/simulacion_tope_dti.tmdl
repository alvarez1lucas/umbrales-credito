	partition simulacion_tope_dti = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\originacion\simulacion_tope_dti.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado0 = Table.TransformColumnTypes(Encabezados, {{"tope_dti", Int64.Type}, {"aprobacion_pct", type number}, {"aprobados_perdidos", Int64.Type}, {"aprobados_perdidos_pct", type number}, {"monto_perdido_pct", type number}, {"spread_anual_perdido", type number}, {"impacto_Negro", type number}, {"impacto_Hispano", type number}, {"impacto_Asiático", type number}, {"perdidos_Blanco_pct", type number}, {"perdidos_Negro_pct", type number}, {"perdidos_Hispano_pct", type number}, {"perdidos_Asiático_pct", type number}}, "en-US"),
				    Resultado1 = Table.AddColumn(Resultado0, "tope", each if [tope_dti] >= 999 then "No cap" else Text.From([tope_dti]), type text)
				in
				    Resultado1

