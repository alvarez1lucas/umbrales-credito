	partition estabilidad_reglas = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\originacion\estabilidad_reglas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado0 = Table.TransformColumnTypes(Encabezados, {{"regla", type text}, {"semestre", type text}, {"margen_pct_monto", type number}}, "en-US"),
				    Resultado1 = Table.TransformColumns(Resultado0, {{"regla", (v) => List.First(List.Select({[a = "Sin cambios", b = "No change"], [a = "Carga <= 20%", b = "Payment burden <= 20%"], [a = "Carga <= 15%", b = "Payment burden <= 15%"], [a = "Carga <= 10%", b = "Payment burden <= 10%"], [a = "Sin ratings F-G", b = "No F-G ratings"], [a = "Sin ratings E-G", b = "No E-G ratings"], [a = "Sin Denmark ni Latvia", b = "No Denmark or Latvia"]}, (r) => r[a] = v))[b], type text}})
				in
				    Resultado1

