	partition mart_previsiones = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\marts\mart_previsiones.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado0 = Table.TransformColumnTypes(Encabezados, {{"fecha_foto", type date}, {"pais", type text}, {"situacion", Int64.Type}, {"etapa", Int64.Type}, {"creditos", Int64.Type}, {"saldo_capital", type number}, {"prevision_bcra", type number}, {"perdida_esperada", type number}}, "en-US")
				in
				    Resultado0

