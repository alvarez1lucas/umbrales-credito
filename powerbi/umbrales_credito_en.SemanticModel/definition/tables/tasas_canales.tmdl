	partition tasas_canales = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\cobranzas\tasas_canales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado0 = Table.TransformColumnTypes(Encabezados, {{"canal", type text}, {"costo", type number}, {"contacto_pct", type number}, {"promesa_pct", type number}, {"cumplimiento_pct", type number}, {"pagos_cada_100", type number}}, "en-US"),
				    Resultado1 = Table.TransformColumns(Resultado0, {{"canal", (v) => List.First(List.Select({[a = "llamada", b = "Call"], [a = "whatsapp", b = "WhatsApp"], [a = "sms", b = "SMS"], [a = "mail", b = "Email"]}, (r) => r[a] = v))[b], type text}})
				in
				    Resultado1

