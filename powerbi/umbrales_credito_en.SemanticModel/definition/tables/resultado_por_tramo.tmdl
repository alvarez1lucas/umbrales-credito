	partition resultado_por_tramo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\cobranzas\resultado_por_tramo.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado0 = Table.TransformColumnTypes(Encabezados, {{"tramo", type text}, {"creditos", Int64.Type}, {"saldo", type number}, {"saldo_medio", type number}, {"prob_mal", type number}, {"prob_cura", type number}}, "en-US")
				in
