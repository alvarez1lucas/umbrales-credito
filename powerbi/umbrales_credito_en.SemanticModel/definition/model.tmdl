model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table dim_pais
ref table dim_rating
ref table dim_situacion
ref table dim_tramo
ref table dim_tramo_desde
ref table dim_tramo_hasta
ref table mart_cartera_tramos
ref table mart_previsiones
ref table mart_perdida_segmentos
ref table mart_cosechas
ref table mart_roll_rates
ref table mart_embudo
ref table mart_motivos_rechazo
ref table mart_aprobacion_dti
ref table simulacion_tope_dti
ref table backtest_priorizacion
ref table escenario_canales
ref table resultado_por_tramo
ref table tasas_canales
ref table regla_canal
ref table simulacion_reglas_bondora
ref table estabilidad_reglas
ref table mart_composicion
ref table mart_deterioro
ref table Metrics

ref cultureInfo en-US

